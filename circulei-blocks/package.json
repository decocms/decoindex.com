{
  "name": "decoindex-circulei-blocks",
  "private": true,
  "type": "module",
  "description": "circulei.decoindex.com on TanStack Start + deco blocks: same pages as circulei/, editable in Studio",
  "scripts": {
    "dev": "npm run generate && vite dev --port 8812",
    "generate": "npm run generate:blocks && npm run generate:sections && npm run generate:schema && tsr generate",
    "generate:blocks": "bun node_modules/@decocms/blocks-cli/scripts/generate-blocks.ts",
    "generate:sections": "bun node_modules/@decocms/blocks-cli/scripts/generate-sections.ts",
    "generate:schema": "bun node_modules/@decocms/blocks-cli/scripts/generate-schema.ts --site circulei",
    "build": "npm run generate && vite build",
    "preview": "npm run build && wrangler dev --port 8812",
    "check": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@decocms/blocks": "7.80.1",
    "@decocms/blocks-admin": "7.80.1",
    "@decocms/blocks-cli": "7.80.1",
    "@decocms/tanstack": "7.80.1",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-router": "1.166.7",
    "@tanstack/react-start": "1.166.8",
    "@tanstack/react-store": "0.9.2",
    "@tanstack/store": "0.9.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.27.0",
    "@cloudflare/workers-types": "^5.20260828.1",
    "@tanstack/router-cli": "1.166.7",
    "@types/node": "22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.72.0"
  }
}
