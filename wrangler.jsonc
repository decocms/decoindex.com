{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decoindex",
  "main": "src/server/main.ts",
  "account_id": "55dd6d847f366735ef6e0f860c7bdc51",
  "compatibility_date": "2026-08-01",

  "observability": { "enabled": true },

  // decoindex.com is not on this Cloudflare account yet (Namecheap nameservers),
  // so we ship on workers.dev. Add the zone, then uncomment.
  // "routes": [{ "pattern": "decoindex.com/*", "zone_name": "decoindex.com" }],
  "workers_dev": true,

  // The registry (which domains exist, which platform) + first-party events.
  "d1_databases": [
    { "binding": "DB", "database_name": "decoindex", "database_id": "82dbbe9a-f533-44ca-bd4f-03d2c6a6ee0c" }
  ],

  // Rendered documents, written without a TTL. This is the lazy index.
  "kv_namespaces": [{ "binding": "CACHE", "id": "8e36e22837104aae8369560db0c5451c" }],

  // Guards invariant 1: bounds first-time reads per merchant domain. Cached
  // reads never reach this.
  "ratelimits": [
    {
      "name": "READ_THROUGH",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "FEEDBACK_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ],

  // The social preview image is static; import it as bytes instead of adding an
  // assets binding and a build step for one file.
  "rules": [{ "type": "Data", "globs": ["**/*.png"], "fallthrough": true }],

  "vars": {
    // Pinned, not derived from the request: rendered documents embed this in
    // their own links and are cached, so it must not vary by hostname.
    "PUBLIC_ORIGIN": "https://decoindex.com",
    "ATTRIBUTION_PARAM": "ref",
    "ATTRIBUTION_VALUE": "decoindex"
  }
}
